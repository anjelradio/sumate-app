# Environment
ENVIRONMENT=DEV

# Database
DATABASE_URL=qlite:///database.db

# Jwt
JWT_SECRET=
JWT_ALG=HS256
JWT_EXPIRES_MIN=1440

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# Redis
REDIS_URL=redis://localhost:6379/0

# Audit
AUDIT_ENABLED=false
AUDIT_ENCRYPTION_KEY=
AUDIT_ACCESS_KEY_LENGTH=10
AUDIT_ACCESS_EXPIRES_MIN=10
AUDIT_ACCESS_MAX_ATTEMPTS=5
AUDIT_ACCESS_SESSION_SEC=1800

